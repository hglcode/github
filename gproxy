#!/bin/sh
set -eu

HERE=$(CDPATH=; cd -- "$(dirname -- "$0")" && pwd -P)

CACHE="$HERE/proxy.conf"

case "${1:-update}" in
    update)
        "$HERE/gmirror" 2> /dev/null | tee "$CACHE"
        ;;
    list)
        [ -f "$HERE/proxy.conf" ] && { cat "$CACHE" || "$HERE/gmirror" 2> /dev/null | tee "$CACHE"; }
        ;;
    *) ;;
esac
